+        if (state.users && !state.users.has(data.user_id)) return send(409, { message: 'foreign key violation' });
+        const extra = Object.keys(data).filter((k) => !['user_id', 'sender', 'staff_id', 'body'].includes(k));
+        if (extra.length) return send(400, { message: 'unknown column ' + extra[0] });
+        const r = { id: ++seq, user_id: data.user_id, sender: data.sender, staff_id: data.staff_id || null, body: data.body, staff_read: false, created_at: new Date().toISOString() };
+        rows.push(r); return send(201, [pick(r)]);
+      }
+      if (req.method === 'PATCH') { for (const r of rows.filter(match)) Object.assign(r, data); return send(204); }
+      if (req.method === 'DELETE') { for (let i = rows.length - 1; i >= 0; i--) if (match(rows[i])) rows.splice(i, 1); return send(204); }
+      send(405, {});
+    });
+  });
+  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => { state.url = `http://127.0.0.1:${server.address().port}`; state.close = () => new Promise((r) => { server.close(r); if (server.closeAllConnections) server.closeAllConnections(); }); resolve(state); }));
+}
