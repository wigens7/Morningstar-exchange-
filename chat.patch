diff -ruN a/supabase/support-schema.sql b/supabase/support-schema.sql
--- a/supabase/support-schema.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/support-schema.sql	2026-10-29 11:50:03.314689804 +0000
@@ -0,0 +1,18 @@
+-- Kole sa a nan Supabase > SQL Editor > Run (apre supabase/schema.sql). San danje pou woule plizyè fwa.
+create table if not exists public.support_messages (
+  id         bigint generated always as identity primary key,
+  user_id    text not null references public.users(id) on delete cascade,  -- efase kont lan = efase mesaj yo tou
+  sender     text not null check (sender in ('user', 'staff')),
+  staff_id   text,
+  body       text not null check (char_length(body) between 1 and 1000),   -- sèlman tèks, maks 1000 karaktè
+  staff_read boolean not null default false,
+  created_at timestamptz not null default now()
+);
+create index if not exists support_messages_user_idx on public.support_messages (user_id, id);
+create index if not exists support_messages_unread_idx on public.support_messages (user_id) where sender = 'user' and not staff_read;
+
+-- Sekirite: sèlman sèvè a (service role). Kle piblik la pa ka li ni ekri.
+alter table public.support_messages enable row level security;
+revoke all on public.support_messages from anon, authenticated;
+grant all on table public.support_messages to service_role;
+grant usage, select on sequence public.support_messages_id_seq to service_role;
